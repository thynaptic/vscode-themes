  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#A1A1A1"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#FE9A00"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#FE9A00"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#1447E6"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#1447E6"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#FAFAFA"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant.language",
        "constant.character",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#FAFAFA"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#FAFAFA"
      }
    }
  ],
  "semanticTokenColors": {
    "comment": {
      "foreground": "#A1A1A1"
    },
    "string": {
      "foreground": "#FE9A00"
    },
    "number": {
      "foreground": "#FE9A00"
    },
    "keyword": {
      "foreground": "#1447E6"
    },
    "function": {
      "foreground": "#1447E6"
    },
    "method": {
      "foreground": "#1447E6"
    },
    "property": {
      "foreground": "#FAFAFA"
    },
    "variable": {
      "foreground": "#FAFAFA"
    },
    "type": {
      "foreground": "#FAFAFA"
    },
    "class": {
      "foreground": "#FAFAFA"
    },
    "parameter": {
      "foreground": "#FAFAFA"
    }
  }
